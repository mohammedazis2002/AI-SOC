# Vault Configuration
VAULT_ADDR=http://vault:8200

# Dev mode root token — must match VAULT_DEV_ROOT_TOKEN in docker-compose.yml
# After vault_setup.sh runs, replace these with the FastAPI AppRole credentials
VAULT_DEV_ROOT_TOKEN=soar-dev-root-token
VAULT_ROLE_ID=your-role-id-from-vault
VAULT_SECRET_ID=your-secret-id-from-vault

# Certificate Configuration
CERT_COMMON_NAME=api.internal
CERT_TTL=720h
CERT_RENEWAL_THRESHOLD_DAYS=7

# Wazuh Certificate Defaults
WAZUH_CERT_COMMON_NAME=wazuh-manager.local
WAZUH_CERT_TTL=720h
WAZUH_ALLOWED_DOMAINS=wazuh.internal,wazuh-manager.local

# mTLS Configuration
REQUIRE_CLIENT_CERT=true
TRUSTED_CLIENT_CN_PATTERN=wazuh.*

# Application
DEBUG=true
