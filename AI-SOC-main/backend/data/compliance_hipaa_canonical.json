    {
        "rule_id": "HIPAA-164.312a1",
        "framework": "hipaa",
        "control_id": "§164.312(a)(1)",
        "control_name": "Access control — unique user identification",
        "category": "access_control",
        "tier": "scoped",
        "rule_type": "action_blocklist",
        "blocked_actions": [
            "create_shared_account",
            "share_credentials",
            "enable_generic_account"
        ],
        "applies_when": {
            "asset_tags": [
                "phi"
            ]
        },
        "enforcement": "reject",
        "severity": "critical",
        "violation_message": "HIPAA §164.312(a)(1): Shared user accounts are prohibited for PHI systems. Unique user identification required.",
        "recommendation": "Remove shared account creation. All PHI access must use unique, individually assigned credentials."
    },
