    {
        "rule_id": "HIPAA-164.312a1",
        "framework": "hipaa",
        "control_id": "§164.312(a)(1)",
        "control_name": "Access Control - Unique User Identification",
        "category": "access_control",
        "tier": "scoped",
        "rule_type": "action_blocklist",
        "blocked_actions": [
            "create_shared_account",
            "share_credentials",
            "grant_unauthorized_access",
            "enable_generic_account"
        ],
        "applies_when": {
            "asset_tags": [
                "phi",
                "healthcare"
            ],
            "environment": [
                "production"
            ]
        },
        "enforcement": "reject",
        "severity": "critical",
        "violation_message": "HIPAA §164.312(a)(1): Cannot create shared access to PHI systems. Every user must have unique credentials.",
        "recommendation": "Use only individually named user accounts for PHI systems."
    },
