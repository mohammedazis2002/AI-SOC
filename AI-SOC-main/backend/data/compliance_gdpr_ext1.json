[
    {
        "rule_id": "GDPR-5.1a",
        "framework": "gdpr",
        "control_id": "Article 5(1)(a)",
        "control_name": "Lawfulness, fairness and transparency of processing",
        "category": "data_governance",
        "tier": "scoped",
        "rule_type": "action_blocklist",
        "blocked_actions": [
            "enable_covert_surveillance",
            "install_hidden_monitoring"
        ],
        "applies_when": {
            "asset_tags": [
                "personal_data"
            ]
        },
        "enforcement": "reject",
        "severity": "critical",
        "violation_message": "GDPR Art. 5(1)(a): Processing personal data through covert means violates lawfulness principle.",
        "recommendation": "Remove covert surveillance actions. Processing must be transparent and lawful."
    },
    {
        "rule_id": "GDPR-5.1b",
