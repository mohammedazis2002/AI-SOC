        "applies_when": {
            "asset_tags": [
                "pci_cde"
            ],
            "incident_type": [
                "data_breach",
                "unauthorized_access"
            ]
        },
        "enforcement": "require_modification",
        "severity": "high",
        "violation_message": "PCI-DSS 10.3.3: Audit logs must be exported to centralized log server before any changes.",
        "recommendation": "Add collect_logs targeting the centralized SIEM."
    },
    {
