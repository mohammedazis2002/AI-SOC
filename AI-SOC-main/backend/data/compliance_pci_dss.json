            "wipe_event_log"
        ],
        "applies_when": {
            "asset_compliance_scope": [
                "pci_dss"
            ],
            "environment": [
                "production"
            ]
        },
        "enforcement": "reject",
        "severity": "critical",
        "violation_message": "PCI-DSS 10.3.2: Audit logs in PCI cardholder data environment must never be deleted or modified.",
        "recommendation": "Remove log deletion actions. Archive logs to secure storage instead."
    },
    {
        "rule_id": "PCI-10.3.3",
        "framework": "pci_dss_v4",
