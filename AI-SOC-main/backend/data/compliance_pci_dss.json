[
    {
        "rule_id": "PCI-10.2.1",
        "framework": "pci_dss_v4",
        "control_id": "10.2.1",
        "control_name": "Log all individual user access to cardholder data",
        "category": "logging",
        "tier": "scoped",
        "rule_type": "required_action",
        "required_action": "collect_logs",
        "must_execute_before": [
            "isolate_host",
            "shutdown_service",
            "disconnect_network",
            "kill_process"
        ],
        "applies_when": {
            "asset_tags": [
                "cardholder_data",
                "pci_cde"
            ],
            "environment": [
                "production"
            ]
        },
        "enforcement": "require_modification",
        "severity": "high",
        "violation_message": "PCI-DSS 10.2.1: Must collect logs before isolating systems with cardholder data.",
        "recommendation": "Add collect_logs before any isolation or shutdown actions."
    },
    {
        "rule_id": "PCI-10.3.2",
        "framework": "pci_dss_v4",
        "control_id": "10.3.2",
        "control_name": "Protect audit logs from destruction and unauthorized modification",
        "category": "logging",
        "tier": "scoped",
        "rule_type": "action_blocklist",
        "blocked_actions": [
            "delete_logs",
            "clear_logs",
            "modify_logs",
            "truncate_logs",
            "disable_logging",
