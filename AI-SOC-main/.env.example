# ============================================================
# SOAR Platform — Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is gitignored; this file is tracked and deployed.
# ============================================================

# ── Web app (Cybolt UI, web_app/) ─────────────────────────────
# Backend runs as service `web-app-backend` (host port 8001). Uses the same
# MongoDB credentials as above; do not set MONGO_URI unless you need an override.
# Frontend: copy web_app/frontend/.env.example → web_app/frontend/.env and set:
#   VITE_API_URL=http://localhost:8001

# ── Application ──────────────────────────────────────────────
APP_NAME=SOAR Platform
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
SECRET_KEY=change_this_secret_key_min_32_chars_random
JWT_SECRET=change_this_jwt_secret_min_32_chars_random
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600          # seconds

# ── HashiCorp Vault ──────────────────────────────────────────
# In Docker: http://vault:8200  |  Local dev: http://127.0.0.1:8200
VAULT_ADDR=http://vault:8200
# Fixed root token for dev mode — must match docker-compose VAULT_DEV_ROOT_TOKEN_ID
VAULT_DEV_ROOT_TOKEN=soar-dev-root-token

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=soar_db
MONGODB_USERNAME=soar_user
MONGODB_PASSWORD=change_this_password
MONGODB_AUTH_SOURCE=admin
# Full URI (overrides the above if set)
# MONGO_URI=mongodb://soar_user:password@localhost:27017/soar_db?authSource=admin

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password
REDIS_DB=0
REDIS_CACHE_DB=1             # TI cache lives here
REDIS_STREAM_INCOMING=alerts:incoming
REDIS_STREAM_DLQ=alerts:dlq
REDIS_STREAM_PRIORITY=alerts:priority
REDIS_CONSUMER_GROUP=soar-consumers

# ── API-Key Auth (JSON objects mapping key → source) ────────
# Keys are loaded at startup; routes reject all requests if unset.
INGESTION_VALID_API_KEYS={"wazuh-api-key-12345": "wazuh", "sentinelone-api-key-67890": "sentinelone", "sumologic-api-key-54321": "sumologic", "custom-api-key-11111": "custom"}
INCIDENTS_VALID_API_KEYS={"wazuh-api-key-12345": "wazuh", "sentinelone-api-key-67890": "sentinelone", "sumologic-api-key-54321": "sumologic", "custom-api-key-11111": "custom"}

# ── Qdrant (Vector KB) ───────────────────────────────────────
#QDRANT_HOST=localhost
#QDRANT_PORT=6333
# Qdrant collection names (used by ingest + retrieval scripts)
#QDRANT_COLLECTION_INCIDENTS=historical_incidents
#QDRANT_COLLECTION_PLAYBOOKS=playbooks
#QDRANT_COLLECTION_COMPLIANCE=compliance_kb
#QDRANT_COLLECTION_MITRE=mitre_attack_defend

# ── LLM (Llama.cpp local server) ─────────────────────────────
# Path to the quantized GGUF model file
LLM_MODEL_PATH=/models/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
LLM_API_URL=http://localhost:8080    # llama.cpp server endpoint
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_CONTEXT_SIZE=8192
# Optional: OpenAI API fallback if local LLM is unavailable
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Threat Intelligence APIs ─────────────────────────────────
# VirusTotal (required for hash/IP/domain scans)
VIRUSTOTAL_API_KEY=your_vt_api_key_here

# AlienVault OTX (required for pulse-based enrichment)
OTX_API_KEY=your_otx_api_key_here

# AbuseIPDB (required for IP confidence scoring)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Abuse.ch suite (MalwareBazaar, ThreatFox, URLhaus)
THREATFOX_API_KEY=your_threatfox_api_key_here
URLHAUS_API_KEY=your_urlhaus_api_key_here
MALWAREBAZAAR_API_KEY=your_malwarebazaar_api_key_here

# GreyNoise (leave blank to use free community API)
GREYNOISE_API_KEY=your_greynoise_api_key_here

# DeepDarkCTI — NO API KEY REQUIRED (free GitHub feeds)
# Pulls ransomware C2, dark web forum, phishing IOC lists automatically

# MISP (deferred — requires self-hosted MISP instance)
# MISP_URL=https://your-misp-instance.example.com
# MISP_API_KEY=your_misp_api_key_here

# OpenCTI (deferred — requires self-hosted OpenCTI instance)
# OPENCTI_URL=https://your-opencti-instance.example.com
# OPENCTI_API_KEY=your_opencti_api_key_here

# ── Wazuh ────────────────────────────────────────────────────
WAZUH_MANAGER_URL=https://your-wazuh-manager:55000
WAZUH_API_USER=your_wazuh_user
WAZUH_API_PASSWORD=your_wazuh_password

# ── SentinelOne (optional) ───────────────────────────────────
# SENTINELONE_CONSOLE_URL=https://your-tenant.sentinelone.net
# SENTINELONE_API_TOKEN=your_s1_api_token_here

# ── ML Microservices ─────────────────────────────────────────
ANOMALY_SERVICE_URL=http://localhost:5001
FP_SERVICE_URL=http://localhost:5002
ATTACK_STAGE_SERVICE_URL=http://localhost:5003
ATTACK_FORECASTER_SERVICE_URL=http://localhost:5004
ASSET_RISK_SERVICE_URL=http://localhost:5005
ROOT_CAUSE_SERVICE_URL=http://localhost:5006

# ── Monitoring ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ── Correlation Engine ───────────────────────────────────────
# Quick correlator
QUICK_CORRELATION_WINDOW_MINUTES=5
QUICK_BURST_THRESHOLD=2
CORRELATION_QUICK_CACHE_MAX_LEN=50
CORR_PHISHING_CRED_WINDOW_M=15
CORR_PS_RANSOM_WINDOW_M=60
CORRELATION_QUICK_CONFIDENCE_THRESHOLD=0.8

# Background correlator
CORRELATION_TEMPORAL_HOURS=24
CORRELATION_ENTITY_DAYS=7
CORRELATION_PATTERN_DAYS=30
CORRELATION_CONFIDENCE_THRESHOLD=0.7
CORRELATION_BACKGROUND_WORKERS=5
CORR_QUEUE_MAX_SIZE=10000
CORR_DLQ_RETRY_DELAY_S=60

# Background correlator — ML endpoints
ANOMALY_DETECTION_URL=http://localhost:5001
ATTACK_STAGE_URL=http://localhost:5002
CORR_ML_TIMEOUT_S=10

# Background correlator — per-layer timeouts (seconds)
CORR_TIMEOUT_TEMPORAL=10
CORR_TIMEOUT_ENTITY=15
CORR_TIMEOUT_PATTERN=20
CORR_TIMEOUT_ML=30

# Incident tracker
CORR_LOCK_TTL_MS=10000
INCIDENT_RETENTION_DAYS=365

# ── Data Retention ───────────────────────────────────────────
ALERT_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
COLD_STORAGE_YEARS=7

# ── Notifications (optional) ─────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
# PAGERDUTY_API_KEY=your_pagerduty_key_here

#-----------------------------------------------------------------------------
# Qdrant Database Configuration
# Update these values to match your running Qdrant instance

# Example for local Docker:
# QDRANT_HOST="localhost"
# QDRANT_PORT="6333"
# QDRANT_API_KEY=""

# Example for Qdrant Cloud / Remote Server:
QDRANT_HOST="localhost"
QDRANT_PORT="6333"

# If your database requires authentication, enter the API key here:
QDRANT_API_KEY=""

# (Optional) If you are using an embedding model other than the default "all-MiniLM-L6-v2"
# EMBED_MODEL="BAAI/bge-large-en-v1.5"

# Docker (web-app-backend on soar-network): default below. API on host only: use https://127.0.0.1:8444/api/v1/certificates if compose maps 8444:8443 to the mTLS service.
MTLS_CERT_API_URL=https://api:8443/api/v1/certificates

#-----------------------------------------------------------------------------
# Vault Configuration
vault_addr=http://127.0.0.1:8200
vault_role_id=<fast-api role id> 
vault_secret_id=<fast-api secret> 

#-----------------------------------------------------------------------------
# Certificate Configuration
CERT_COMMON_NAME=api.internal
CERT_TTL=720h
CERT_RENEWAL_THRESHOLD_DAYS=7

#-----------------------------------------------------------------------------
# mTLS Configuration
REQUIRE_CLIENT_CERT=true
TRUSTED_CLIENT_CN_PATTERN=wazuh.*

#-----------------------------------------------------------------------------
# Application
DEBUG=true
